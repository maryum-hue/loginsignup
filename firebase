const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

export default function Crud() {
    const [notes, setNotes] = useState([]);
    const [noteText, setNoteText] = useState('');
    const [editingId, setEditingId] = useState(null);

    const notesCollection = collection(db, 'notes');
 
    //fechdatafromfirebase

    const fecithngdatafromfirbase = async () => {
        const snapshot = await getDocs(notesCollection);
        const arrayofnotes = snapshot.docs.map((doc) =>({
            id: doc.id,
            ...doc.data()
        }))
        setNotes(arrayofnotes)
    }

useEffect(() => {
    fecithngdatafromfirbase();
}, []);



//add notes new notes

const addNotes = async () => {
    if(!noteText) return;
    await addDoc(notesCollection, {text: noteText});
    setNoteText('')
    fecithngdatafromfirbase();
}

//editing notes here

const editnote = (note) => {
    setEditingId(note.id);
    setNoteText(note.text);
};

//updtae note

const updateNote = async () => {
 if (!noteText) return;
  const noteRef = doc(db, 'notes', editingId)
await updateDoc(noteRef, {text: noteText});
    setEditingId(null);
    setNoteText("");
    fecithngdatafromfirbase();
}

//deltethenote here funct

const deleteNote = async (id) => {
    const noteRef = doc(db, 'notes', id);
    await deleteDoc(noteRef);
    fecithngdatafromfirbase();
};



return(
    <div>
<h2>Firestore Note App</h2>
<input type="text"
value={noteText}
onChange={(e) => setNoteText(e.target.value)}
 placeholder="Write a note..."  
/>
{
    editingId ? (
        <button onClick={updateNote}> update </button>
    ) : (
        <button onClick={addNotes}>add note</button>
    )
}
<ul>
   {notes.map((note) => (
    <li key={note.id}>{note.text}
    <button onClick={editnote}>edit</button>
    <button onClick={deleteNote}>delete</button>
    
    </li>
   ))}
</ul>
    </div>
)
}

